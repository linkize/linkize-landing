# Linkize Landing Page Configuration

# Supabase
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Email Service (Nodemailer)
# Opção 1: Gmail (recomendado)
GMAIL_USER=seu.email@gmail.com
GMAIL_PASSWORD=sua_senha_de_app_16_caracteres

# Opção 2: Ethereal será usado automaticamente se GMAIL_USER estiver vazio

# Servidor de Email (desenvolvimento)
VITE_EMAIL_SERVER_URL=http://localhost:3001
EMAIL_SERVER_PORT=3001